<%- include('partials/header', { active: 'records' }) %>

<header class="view-header">
  <h1>Patient records</h1>
  <p>Live data from RDS &middot; synced through the validation and archival pipeline.</p>
</header>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Patient ref</th>
        <th>File name</th>
        <th>Uploaded by</th>
        <th>Status</th>
        <th>Uploaded at</th>
        <th class="right">Action</th>
      </tr>
    </thead>

    <tbody>

      <% if (records.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align:center;padding:20px;">
            No records found.
          </td>
        </tr>
      <% } %>

      <% records.forEach(function(r){ %>

      <tr>

        <td><%= r.patient_ref %></td>

        <td><%= r.file_name %></td>

        <td><%= r.uploaded_by %></td>

        <td>
          <span class="badge <%= r.storage_status %>">
            <%= r.storage_status %>
          </span>
        </td>

        <td>
          <%= new Date(r.uploaded_at).toLocaleString() %>
        </td>

        <td style="text-align:right">

          <a class="icon-btn"
             href="/download/<%= r.file_id %>">
             ⬇ Download
          </a>

        </td>

      </tr>

      <% }) %>

    </tbody>

  </table>
</div>

<%- include('partials/footer') %>
