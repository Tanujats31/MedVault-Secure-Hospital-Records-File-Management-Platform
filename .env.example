# Copy this file to .env and fill in your real values.
# Never commit the real .env file anywhere.

# App
PORT=3000
SESSION_SECRET=CHANGE_ME_to_a_long_random_string

# RDS (Phase 8)
DB_HOST=medvault-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=medvault_app
DB_PASS=CHANGE_ME
DB_NAME=medvault

# File Server FTPS technical account (created in this guide, Step 2)
FTP_HOST=10.20.20.XX
FTP_USER=portal_uploader
FTP_PASS=CHANGE_ME

# API Gateway (Phase 10) - metadata insert endpoint
API_METADATA_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod/metadata

# CloudFront (Phase 11 Part B) - for signed download URLs
CF_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net
CF_KEY_PAIR_ID=K2EXAMPLEKEYPAIRID
CF_PRIVATE_KEY_PATH=/home/ec2-user/cf-signing-private-key.pem
